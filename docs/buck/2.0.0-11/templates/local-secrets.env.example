# Buck Next local secret environment template.
# Copy values from the team password manager into:
#   ~/.brick/brick-next/local-secrets.env
# Keep the directory chmod 700 and this file chmod 600. Do not commit real values.

# Common local runtime datasource.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres?currentSchema=<schema>
SPRING_DATASOURCE_USERNAME=<username>
SPRING_DATASOURCE_PASSWORD=<secret>

# Database-specific smoke variables.
BRICK_DM_JDBC_URL=jdbc:dm://<host>:5236?useTimezone=true&serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf8&allowMultiQueries=true&tinyInt1isBit=false
BRICK_DM_USERNAME=<schema-user>
BRICK_DM_PASSWORD=<secret>

BRICK_ORACLE_JDBC_URL=jdbc:oracle:thin:@//<host>:1521/<service>
BRICK_ORACLE_USERNAME=<schema-user>
BRICK_ORACLE_PASSWORD=<secret>

BRICK_PG_JDBC_URL=jdbc:postgresql://<host>:5432/<database>?currentSchema=<schema>
BRICK_PG_USERNAME=<schema-user>
BRICK_PG_PASSWORD=<secret>

BRICK_MYSQL_JDBC_URL=jdbc:mysql://<host>:3306/<database>?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
BRICK_MYSQL_USERNAME=<schema-user>
BRICK_MYSQL_PASSWORD=<secret>

BRICK_GAUSS_JDBC_URL=jdbc:opengauss://<host>:5432/<database>
BRICK_GAUSS_USERNAME=<schema-user>
BRICK_GAUSS_PASSWORD=<secret>

# Validation smoke runtime policy values.
# Used only when a real validation database has no enabled initial-password policy yet.
BRICK_SECURITY_CONSOLE_INITIAL_PASSWORD=<secret>

# Publishing and package registry credentials.
NEXUS_URL=<nexus-url>
NEXUS_MAVEN_URL=<nexus-maven-url>
NEXUS_USERNAME=<username>
NEXUS_PASSWORD=<secret>

NPM_REGISTRY_URL=<npm-registry-url>
NPM_TOKEN=<secret>
# Use the username/password fallback only when token auth is unavailable.
NPM_USERNAME=<username>
NPM_PASSWORD=<secret>
NPM_EMAIL=<email>

# Maven Central Portal user token and GPG signing. CI reads GitHub Actions secrets
# MAVEN_CENTRAL_USERNAME, MAVEN_CENTRAL_PASSWORD, SIGNING_KEY, SIGNING_KEY_ID, SIGNING_PASSWORD.
MAVEN_CENTRAL_USERNAME=<username>
MAVEN_CENTRAL_PASSWORD=<secret>
SIGNING_KEY=<ascii-armored-private-key>
SIGNING_KEY_ID=<8-char-key-id>
SIGNING_PASSWORD=<secret>

# Business CI/CD and runtime delivery credentials.
FS_URL=<fs-url>
REGISTRY_URL=<registry-url>
DOCKER_USER=<username>
DOCKER_PASS=<secret>
NAMESPACE=<namespace-prefix>
# Formal EMAIL/SMTP channel credentials for notification-setting acceptance (never commit real values).
# Used when validating real mail delivery; debugging inbox is not a product-grade substitute.
BRICK_SMTP_HOST=<smtp-host>
BRICK_SMTP_PORT=465
BRICK_SMTP_USERNAME=<smtp-username>
BRICK_SMTP_PASSWORD=<secret>
BRICK_SMTP_FROM=<from-address>
BRICK_SMTP_SSL_ENABLE=true
